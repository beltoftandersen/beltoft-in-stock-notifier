#. Plugin Name of the plugin
#: beltoft-in-stock-notifier.php
msgid "Beltoft In-Stock Notifier for WooCommerce"
msgstr "Beltoft In-Stock Notifier for WooCommerce"

#. Plugin URI of the plugin
#: beltoft-in-stock-notifier.php
msgid "https://wordpress.org/plugins/beltoft-in-stock-notifier/"
msgstr "https://wordpress.org/plugins/beltoft-in-stock-notifier/"

#. Description of the plugin
#: beltoft-in-stock-notifier.php
msgid ""
"Let customers subscribe to out-of-stock product notifications and "
"automatically email them when items are back in stock."
msgstr ""
"Umožněte zákazníkům přihlásit se k odběru oznámení o nedostupných produktech "
"a automaticky jim zašlete e-mail, jakmile budou položky opět skladem."

#. Author of the plugin
#: beltoft-in-stock-notifier.php
msgid "beltoft.net"
msgstr "beltoft.net"

#. Author URI of the plugin
#: beltoft-in-stock-notifier.php
msgid "https://beltoft.net"
msgstr "https://beltoft.net"

#. translators: %s: WooCommerce plugin name
#: beltoft-in-stock-notifier.php:55
msgid "In-Stock Notifier requires WooCommerce to be installed and active."
msgstr ""
"In-Stock Notifier vyžaduje, aby byl plugin WooCommerce nainstalován a "
"aktivní."

